[user]
	name = mkolibaba
	email = avierdaner@gmail.com
[diff]
    external = difft
[core]
	autocrlf = input
	pager = delta
[includeIf "gitdir:~/projects/lenta/"]
	path = ~/projects/lenta/.gitconfig
[alias]
	changed = status -s
	branches = branch --format='%(HEAD) %(color:yellow)%(refname:short)%(color:reset) - %(contents:subject) %(color:green)(%(committerdate:relative))%(color:reset) %(color:magenta)[%(authorname)]%(color:reset)' --sort=-committerdate
	lore = log --pretty=format:'%C(yellow)%h%Creset -%C(blue)%d%Creset %s %C(green)(%cr) %C(magenta)[%an]%Creset' --abbrev-commit -30
	erase = restore
	cm = commit -m
	cam = commit -a -m
	d = diff
	ds = diff --stat
	co = checkout
	cob = checkout -b
	del = branch -D
	a = add
	ap = add -p
	aa = add -A
	undo = reset HEAD~1 --mixed
	res = reset --hard
	lg = log --all --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
[push]
	autoSetupRemote = true
[blame]
	coloring = highlightRecent
	# date = human
[interactive]
	diffFilter = delta --color-only
[color "blame"]
    highlightRecent = 237, 20 month ago, 238, 19 month ago, 239, 18 month ago, 240, 17 month ago, 241, 16 month ago, 242, 15 month ago, 243, 14 month ago, 244, 13 month ago, 245, 12 month ago, 246, 11 month ago, 247, 10 month ago, 248, 9 month ago, 249, 8 month ago, 250, 7 month ago, 251, 6 month ago, 252, 5 month ago, 253, 4 month ago, 254, 3 month ago, 231, 2 month ago, 230, 1 month ago, 229, 3 weeks ago, 228, 2 weeks ago, 227, 1 week ago, 226
