encryption = "age"
[age]
identity = "~/.config/chezmoi/key.txt"
recipient = "age17frrz8aaky67rtx9uqm5ng6mcy7aewqzruucm8cq7srf827myppqj7hvjs"

[git]
autoCommit = true
autoPush = true

[diff]
command = "difft"
args = [
  "--color",
  "always",
  "--skip-unchanged"
]

[merge]
command = "nu"
args = [
  "-c",
  "cp {{ .Target | quote }} {{ printf '%s.base' .Target | quote }}; code --new-window --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf '%s.base' .Target | quote }} {{ .Source | quote }}",
]

[hooks.apply.post]
command = "mise"
args = ["install"]
